---
// src/layouts/Layout.astro
import Head from '../components/Head.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
}

const { 
  title = 'Tarot de Marsella', 
  description = 'Explora el conocimiento ancestral del Tarot de Marsella',
  canonicalUrl,
  ogImage,
  ogImageAlt,
  noindex
} = Astro.props;
const computedCanonical = canonicalUrl ?? Astro.url?.href;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <Head 
    title={title} 
    description={description} 
    ogImage={ogImage}
    ogImageAlt={ogImageAlt}
    noindex={noindex}
  />
  {computedCanonical && <link rel="canonical" href={computedCanonical} />}
  <style>
    :root {
      --font-heading: 'Cardo', serif;
      --font-body: 'Montserrat', sans-serif;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col font-body">
  <Navbar />
  
  <main class="flex-grow">
    <slot />
  </main>
  
  <Footer />
  
</body>
</html>