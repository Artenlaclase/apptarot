---
// src/layouts/AdminLayout.astro
import '../styles/admin.css';
interface Props { title?: string }
const { title = 'Administración' } = Astro.props as Props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | Admin</title>
</head>
<body class="bg-gray-50">
  <header class="bg-purple-900 text-white shadow">
    <div class="container mx-auto px-4 py-3 flex justify-between items-center">
      <a href="/" class="text-xl font-bold">Panel de Administración</a>
      <nav>
        <a href="/cards" class="hover:text-purple-200">Cartas</a>
      </nav>
    </div>
  </header>
  
  <slot />
  
</body>
</html>