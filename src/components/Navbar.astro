---
// src/components/Navbar.astro
// No necesitamos ningún return en este componente
const user = Astro.locals.user;
const lecturaHref = user
  ? '/cards/random-cards'
  : '/auth/login?next=%2Fcards%2Frandom-cards&message=lectura';
const authOnlyClass = user ? '' : 'hidden';
const guestOnlyClass = user ? 'hidden' : '';
---

<nav class="app-nav shadow-lg">
  <div class="container mx-auto px-4 py-3 flex justify-between items-center">
    <a href="/" class="text-2xl font-bold flex items-center gap-2 app-nav-brand transition-colors font-heading">
      <span>✨</span>
      <span>Marsella</span>
    </a>
    
    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center space-x-6">
      <a href="/about" class="app-nav-link transition-colors">Acerca del Tarot</a>
      <a href="/cards" class="app-nav-link transition-colors">Mazo completo</a>
      <a href={lecturaHref} class="app-nav-link transition-colors">Lectura</a>
      <a href="/profile" data-auth-only class={`app-nav-link transition-colors ${authOnlyClass}`}>Mi Perfil</a>
      <a href="/auth/login" data-guest-only class={`app-nav-link transition-colors ${guestOnlyClass}`}>Iniciar sesión</a>
      <button
        type="button"
        data-auth-only
        data-logout-btn
        class={`app-nav-link app-nav-logout-btn transition-colors ${authOnlyClass}`}
        aria-label="Cerrar sesión"
      >
        Cerrar sesión
      </button>
      <a href="https://www.instagram.com/tarot_marsella_terapeutico/" target="_blank" rel="noopener noreferrer" class="app-nav-link transition-colors">RRSS</a>
    </div>
    
    <!-- Mobile Menu Button -->
    <button 
      class="md:hidden focus:outline-none" 
      id="mobileMenuButton"
      aria-expanded="false"
      aria-label="Menú mobile"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
  
  <!-- Mobile Menu -->
  <div class="md:hidden hidden app-nav-mobile" id="mobileMenu">
    <div class="container mx-auto px-4 py-2 flex flex-col space-y-3">
      <a href="/about" class="block py-2 app-nav-link transition-colors">Acerca del Tarot</a>
      <a href="/cards" class="block py-2 app-nav-link transition-colors">Mazo completo</a>
      <a href={lecturaHref} class="block py-2 app-nav-link transition-colors">Lectura</a>
      <a href="/profile" data-auth-only class={`block py-2 app-nav-link transition-colors ${authOnlyClass}`}>Mi Perfil</a>
      <a href="/auth/login" data-guest-only class={`block py-2 app-nav-link transition-colors ${guestOnlyClass}`}>Iniciar sesión</a>
      <button
        type="button"
        data-auth-only
        data-logout-btn
        class={`block py-2 text-left app-nav-link app-nav-logout-btn transition-colors ${authOnlyClass}`}
        aria-label="Cerrar sesión"
      >
        Cerrar sesión
      </button>
      <a href="https://www.instagram.com/tarot_marsella_terapeutico/" target="_blank" rel="noopener noreferrer" class="block py-2 app-nav-link transition-colors">RRSS</a>
    </div>
  </div>
</nav>

<script>
  import { auth } from '../lib/firebase';
  import { onAuthStateChanged, signOut } from 'firebase/auth';

  function syncAuthUI(isAuthenticated: boolean) {
    document.querySelectorAll('[data-auth-only]').forEach((el) => {
      el.classList.toggle('hidden', !isAuthenticated);
    });

    document.querySelectorAll('[data-guest-only]').forEach((el) => {
      el.classList.toggle('hidden', isAuthenticated);
    });
  }

  async function handleLogout(button: HTMLButtonElement) {
    const originalText = button.textContent;
    button.disabled = true;
    button.textContent = 'Cerrando...';

    try {
      await fetch('/api/auth/session-logout', {
        method: 'POST',
        credentials: 'same-origin',
      });
      await signOut(auth);
      syncAuthUI(false);
      window.location.href = '/';
    } catch (error) {
      console.error('Error al cerrar sesión:', error);
      button.disabled = false;
      button.textContent = originalText;
      alert('No se pudo cerrar sesión. Inténtalo de nuevo.');
    }
  }

  document.getElementById('mobileMenuButton')?.addEventListener('click', () => {
    const button = document.getElementById('mobileMenuButton');
    const menu = document.getElementById('mobileMenu');

    if (button && menu) {
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
    }
  });

  document.querySelectorAll('[data-logout-btn]').forEach((btn) => {
    if (!(btn instanceof HTMLButtonElement)) return;
    btn.addEventListener('click', () => handleLogout(btn));
  });

  onAuthStateChanged(auth, (firebaseUser) => {
    syncAuthUI(Boolean(firebaseUser));
  });
</script>

<style>
  .app-nav {
    background: color-mix(in srgb, var(--primary) 84%, #111111);
    color: #ffffff;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 35%, transparent);
  }

  .app-nav-mobile {
    background: color-mix(in srgb, var(--primary) 70%, #111111);
  }

  .app-nav-brand,
  .app-nav-link,
  .app-nav-icon {
    color: color-mix(in srgb, #ffffff 88%, var(--surface));
  }

  .app-nav-logout-btn {
    border: 1px solid color-mix(in srgb, #ffffff 28%, var(--border));
    border-radius: 9999px;
    padding: 0.45rem 0.9rem;
    line-height: 1;
  }

  .app-nav-logout-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .app-nav-brand:hover,
  .app-nav-link:hover,
  .app-nav-icon:hover {
    color: #ffffff;
  }

  .app-nav-muted {
    color: color-mix(in srgb, #ffffff 70%, var(--text-muted));
  }

  .app-nav-separator {
    border-left: 1px solid color-mix(in srgb, #ffffff 22%, var(--border));
    border-top: 1px solid color-mix(in srgb, #ffffff 22%, var(--border));
  }

  @media (min-width: 768px) {
    .app-nav-separator {
      border-top: 0;
    }
  }
</style>