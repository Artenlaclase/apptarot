---
interface Props {
  idPrefix?: string;
  includeFullName?: boolean;
  initialFirstName?: string;
  initialLastName?: string;
  initialBirthDate?: string;
  initialBirthHour?: string;
}

const {
  idPrefix = 'arcane',
  includeFullName = true,
  initialFirstName = '',
  initialLastName = '',
  initialBirthDate = '',
  initialBirthHour = '',
} = Astro.props;

const firstNameId = `${idPrefix}-firstName`;
const lastNameId = `${idPrefix}-lastName`;
const birthDateId = `${idPrefix}-birthDate`;
const birthHourId = `${idPrefix}-birthHour`;
const helperId = `${idPrefix}-helper`;
const previewId = `${idPrefix}-preview`;
const previewTextId = `${idPrefix}-previewText`;
const previewHintId = `${idPrefix}-previewHint`;
const numberHiddenId = `${idPrefix}-arcaneNumber`;
const nameHiddenId = `${idPrefix}-arcaneName`;
const fullNameHiddenId = `${idPrefix}-fullName`;

function toDateInputValue(value: string): string {
  if (!value) return '';
  if (/^\d{4}-\d{2}-\d{2}$/.test(value)) return value;
  if (/^\d{2}\/\d{2}\/\d{4}$/.test(value)) {
    const [day, month, year] = value.split('/');
    return `${year}-${month}-${day}`;
  }
  return '';
}

const initialBirthDateValue = toDateInputValue(initialBirthDate);
---

<section id={`${idPrefix}-calculator`} class="space-y-4">
  {includeFullName && (
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-semibold mb-1" for={firstNameId}>Nombre</label>
        <input
          id={firstNameId}
          name="firstName"
          type="text"
          value={initialFirstName}
          autocomplete="given-name"
          required
          placeholder="Ej. Ana"
          class="w-full rounded-lg border px-3 py-2"
          style="border-color: var(--border); background: var(--surface);"
        />
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1" for={lastNameId}>Apellido</label>
        <input
          id={lastNameId}
          name="lastName"
          type="text"
          value={initialLastName}
          autocomplete="family-name"
          required
          placeholder="Ej. Perez"
          class="w-full rounded-lg border px-3 py-2"
          style="border-color: var(--border); background: var(--surface);"
        />
      </div>
      <p class="text-xs md:col-span-2 -mt-1" style="color: var(--text-muted);">Completa nombre y apellido tal como quieres guardarlos en tu perfil.</p>
    </div>
  )}

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-semibold mb-1" for={birthDateId}>Fecha de nacimiento</label>
      <input
        id={birthDateId}
        name="birthDate"
        type="date"
        value={initialBirthDateValue}
        autocomplete="bday"
        required
        aria-describedby={helperId}
        class="w-full rounded-lg border px-3 py-2"
        style="border-color: var(--border); background: var(--surface);"
      />
      <p id={helperId} class="text-xs mt-1" style="color: var(--text-muted);">
        Puedes escribir la fecha o elegirla desde el selector del navegador. El Arcano se calcula sumando día + mes + año.
      </p>
    </div>

    <div>
      <label class="block text-sm font-semibold mb-1" for={birthHourId}>Hora de nacimiento (opcional)</label>
      <input
        id={birthHourId}
        name="birthHour"
        type="time"
        value={initialBirthHour}
        class="w-full rounded-lg border px-3 py-2"
        style="border-color: var(--border); background: var(--surface);"
      />
      <p class="text-xs mt-1" style="color: var(--text-muted);">Se guarda para funcionalidades futuras de tirada personalizada.</p>
    </div>
  </div>

  <input id={numberHiddenId} name="personalArcaneNumber" type="hidden" value="" />
  <input id={nameHiddenId} name="personalArcaneName" type="hidden" value="" />
  <input id={fullNameHiddenId} name="fullName" type="hidden" value="" />

  <div id={previewId} class="hidden rounded-xl px-4 py-3 transition-all duration-300" style="background: color-mix(in srgb, var(--primary) 10%, var(--surface)); border: 1px solid color-mix(in srgb, var(--primary) 28%, var(--border));">
    <p id={previewTextId} class="font-semibold" style="color: var(--text);"></p>
    <p id={previewHintId} class="text-xs mt-1" style="color: var(--text-muted);">Este resultado se guardará en tu perfil.</p>
  </div>
</section>

<script is:inline define:vars={{ idPrefix, includeFullName }} type="module">
  import {
    calculatePersonalArcane,
    normalizeBirthDateInput,
    validateBirthDate,
    validateBirthHour,
    validateFullName,
  } from '/src/lib/arcaneCalculator.ts';

  const firstNameInput = document.getElementById(`${idPrefix}-firstName`);
  const lastNameInput = document.getElementById(`${idPrefix}-lastName`);
  const birthDateInput = document.getElementById(`${idPrefix}-birthDate`);
  const birthHourInput = document.getElementById(`${idPrefix}-birthHour`);
  const preview = document.getElementById(`${idPrefix}-preview`);
  const previewText = document.getElementById(`${idPrefix}-previewText`);
  const numberHidden = document.getElementById(`${idPrefix}-arcaneNumber`);
  const nameHidden = document.getElementById(`${idPrefix}-arcaneName`);
  const fullNameHidden = document.getElementById(`${idPrefix}-fullName`);

  function buildFullName() {
    const firstName = firstNameInput ? firstNameInput.value.trim() : '';
    const lastName = lastNameInput ? lastNameInput.value.trim() : '';
    return [firstName, lastName].filter(Boolean).join(' ').trim();
  }

  function setFieldValidity(element, validation) {
    if (!element) return;
    if (validation.valid) {
      element.setCustomValidity('');
    } else {
      element.setCustomValidity(validation.message || 'Campo inválido.');
    }
  }

  function updatePreview() {
    const birthDate = birthDateInput ? birthDateInput.value : '';
    const normalizedDate = normalizeBirthDateInput(birthDate);
    const dateValidation = validateBirthDate(normalizedDate);
    setFieldValidity(birthDateInput, dateValidation);

    const fullName = buildFullName();
    if (includeFullName) {
      const fullNameValidation = validateFullName(fullName);
      setFieldValidity(firstNameInput, fullNameValidation);
      setFieldValidity(lastNameInput, fullNameValidation);
    }

    if (birthHourInput) {
      setFieldValidity(birthHourInput, validateBirthHour(birthHourInput.value));
    }

    if (fullNameHidden) fullNameHidden.value = fullName;

    if (!dateValidation.valid) {
      if (preview) preview.classList.add('hidden');
      if (numberHidden) numberHidden.value = '';
      if (nameHidden) nameHidden.value = '';
      return;
    }

    const result = calculatePersonalArcane(normalizedDate);
    if (numberHidden) numberHidden.value = String(result.number);
    if (nameHidden) nameHidden.value = result.name;

    if (preview && previewText) {
      preview.classList.remove('hidden');
      previewText.textContent = `Tu Arcano Personal sería ${result.number}: ${result.name}`;
    }

    const container = document.getElementById(`${idPrefix}-calculator`);
    if (container) {
      container.dispatchEvent(
        new CustomEvent('arcanechange', {
          detail: {
            number: result.number,
            name: result.name,
            birthDate: normalizedDate,
            fullName,
            firstName: firstNameInput ? firstNameInput.value.trim() : '',
            lastName: lastNameInput ? lastNameInput.value.trim() : '',
            birthHour: birthHourInput ? birthHourInput.value.trim() : '',
            valid: true,
          },
          bubbles: true,
        })
      );
    }
  }

  [firstNameInput, lastNameInput, birthDateInput, birthHourInput].forEach((el) => {
    el?.addEventListener('input', updatePreview);
    el?.addEventListener('blur', updatePreview);
  });

  if (birthDateInput?.value) {
    updatePreview();
  }
</script>
