---
// src/components/Head.astro
interface HeadProps {
	title: string;
	description: string;
	ogImage?: string;
	ogImageAlt?: string;
	noindex?: boolean;
}
const { title, description, ogImage, ogImageAlt, noindex } = Astro.props as HeadProps;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={description} />
{noindex ? (
	<meta name="robots" content="noindex,nofollow" />
 ) : (
	<meta name="robots" content="index,follow" />
 )}
<meta name="theme-color" content="#4c1d95" />

<title>{title}</title>

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cardo:wght@400;700&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">

<!-- PWA Manifest -->
<link rel="manifest" href="/site.webmanifest" />

<!-- Open Graph / Social Meta Tags -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url.href} />
<meta property="og:image" content={ogImage ?? '/marsella-tarot.jpg'} />
<meta property="og:site_name" content="Tarot de Marsella" />
<meta property="og:locale" content="es_ES" />
<meta property="og:image:alt" content={ogImageAlt ?? 'Cartas del Tarot de Marsella'} />

<!-- Twitter Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage ?? '/marsella-tarot.jpg'} />
<meta name="twitter:image:alt" content={ogImageAlt ?? 'Cartas del Tarot de Marsella'} />