---
import Layout from '../layouts/Layout.astro';
const title = 'Política de Cookies';
const description = 'Información sobre el uso de cookies en el sitio.';
---

<Layout {title} {description}>
  <main class="container mx-auto px-4 py-12 prose">
    <h1>{title}</h1>
    <p>Actualmente intentamos minimizar el uso de cookies. Si añadimos analítica o terceros, actualizaremos esta sección.</p>
  </main>
</Layout>
