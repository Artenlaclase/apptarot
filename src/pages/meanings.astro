---
import Layout from '../layouts/Layout.astro';
const title = 'Significados del Tarot de Marsella';
const description = 'Explora interpretaciones y palabras clave de los arcanos mayores y menores.';
---

<Layout {title} {description}>
  <main class="container mx-auto px-4 py-12">
    <header class="text-center mb-8">
      <h1 class="text-4xl font-bold text-purple-900">{title}</h1>
      <p class="text-purple-700 max-w-2xl mx-auto">Recopilación de significados para estudio y práctica.</p>
    </header>
    <section class="grid md:grid-cols-2 gap-6">
      <article class="bg-white rounded-xl shadow p-6">
        <h2 class="text-2xl font-semibold mb-2">Arcanos Mayores</h2>
        <p class="text-gray-600">Pronto añadiremos una tabla con palabras clave, luces y sombras de cada carta.</p>
      </article>
      <article class="bg-white rounded-xl shadow p-6">
        <h2 class="text-2xl font-semibold mb-2">Arcanos Menores</h2>
        <p class="text-gray-600">Incluiremos correspondencias por palo y número para facilitar la memorización.</p>
      </article>
    </section>
  </main>
</Layout>
