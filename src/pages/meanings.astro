---
import Layout from '../layouts/Layout.astro';
const title = 'Significados del Tarot de Marsella';
const description = 'Explora interpretaciones y palabras clave de los arcanos mayores y menores.';
---

<Layout {title} {description}>
  <main class="container mx-auto px-4 py-8 md:py-12">
    <header class="text-center mb-6 md:mb-8">
      <h1 class="text-3xl md:text-4xl font-bold page-title">{title}</h1>
      <p class="page-lead max-w-2xl mx-auto">Recopilación de significados para estudio y práctica.</p>
    </header>
    <section class="grid md:grid-cols-2 gap-4 md:gap-6">
      <article class="surface-card p-5 md:p-6">
        <h2 class="text-xl md:text-2xl font-semibold mb-2 page-title">Arcanos Mayores</h2>
        <p class="page-lead">Pronto añadiremos una tabla con palabras clave, luces y sombras de cada carta.</p>
      </article>
      <article class="surface-card p-5 md:p-6">
        <h2 class="text-xl md:text-2xl font-semibold mb-2 page-title">Arcanos Menores</h2>
        <p class="page-lead">Incluiremos correspondencias por palo y número para facilitar la memorización.</p>
      </article>
    </section>
  </main>
</Layout>
