---
import Layout from '../../../layouts/Layout.astro';
import { adminDb } from '../../../lib/firebase-admin';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/auth/login');
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/account/readings');
}

const readingSnap = await adminDb
  .collection('users')
  .doc(user.uid)
  .collection('readings')
  .doc(id)
  .get();

if (!readingSnap.exists) {
  return Astro.redirect('/account/readings');
}

function formatFirestoreDate(val: any): string {
  if (!val) return '';
  if (typeof val.toDate === 'function') {
    return val.toDate().toISOString();
  }
  if (val instanceof Date) {
    return val.toISOString();
  }
  if (typeof val === 'string') {
    return val;
  }
  try {
    const d = new Date(val);
    return isNaN(d.getTime()) ? '' : d.toISOString();
  } catch {
    return '';
  }
}

const data = readingSnap.data() || {};
const reading = {
  createdAt: formatFirestoreDate(data.createdAt),
  cards: Array.isArray(data.cards) ? data.cards : [],
  interpretation: data.interpretation || '',
  pregunta: data.pregunta || null,
};

const title = 'Detalle de tirada';
const description = 'Consulta el detalle completo de una lectura guardada.';
---

<Layout {title} {description}>
  <main class="container mx-auto max-w-4xl px-4 py-10 space-y-6">
    <header>
      <a href="/account/readings" class="token-link">← Volver al historial</a>
      <h1 class="text-3xl font-bold page-title mt-2">Detalle de tirada</h1>
      <p class="page-lead">Fecha: {reading.createdAt ? new Date(reading.createdAt).toLocaleString('es-ES') : 'Sin fecha'}</p>
    </header>

    {reading.pregunta && (
      <section class="surface-card p-6 border-l-4" style="border-left-color: var(--primary);">
        <h2 class="text-sm uppercase tracking-wider font-semibold mb-2" style="color: var(--text-muted);">Pregunta / Intención</h2>
        <p class="text-lg italic font-medium" style="color: var(--text);">"{reading.pregunta}"</p>
      </section>
    )}

    <section class="surface-card p-6">
      <h2 class="text-xl font-semibold page-title mb-4">Cartas</h2>
      <ul class="space-y-2">
        {(reading.cards || []).map((card) => {
          const isStr = typeof card === 'string';
          const nombre = isStr ? card : card?.nombre || '';
          const arcano = isStr ? '' : card?.arcano || '';
          const numero = isStr ? null : card?.numero;
          const valor = isStr ? '' : card?.valor || '';
          return (
            <li class="app-surface-soft rounded-lg p-3">
              <strong>{nombre}</strong>
              {(arcano || numero || valor) && (
                <span class="page-lead"> · {arcano}{numero ? ` #${numero}` : ''}{valor ? ` ${valor}` : ''}</span>
              )}
            </li>
          );
        })}
      </ul>
    </section>

    <section class="surface-card p-6">
      <h2 class="text-xl font-semibold page-title mb-4">Interpretación IA</h2>
      <p class="leading-relaxed" style="color: var(--text);">{reading.interpretation || 'Sin interpretación'}</p>
    </section>
  </main>
</Layout>
