---
import Layout from '../layouts/Layout.astro';
import { getOrCreateUserProfile } from '../lib/auth-server';
import { getPlanLabel, getReadingLimit, isPremiumPlan } from '../lib/plans';
import PersonalArcaneCalculator from '../components/PersonalArcaneCalculator.astro';
import { getPersonalArcaneBreakdown } from '../lib/arcaneCalculator';
import { adminDb } from '../lib/firebase-admin';
import { Image } from 'astro:assets';
import '../styles/cards.css';

interface ProfileArcaneCard {
  id: string;
  numero?: string | number;
  imagem?: string | null;
  imagen?: string | null;
}

function splitFullName(fullName: string | undefined): { firstName: string; lastName: string } {
  const clean = (fullName || '').trim().replace(/\s+/g, ' ');
  if (!clean) return { firstName: '', lastName: '' };
  const parts = clean.split(' ');
  return {
    firstName: parts[0] || '',
    lastName: parts.slice(1).join(' '),
  };
}

function getProfileArcaneImage(card: ProfileArcaneCard | null): string {
  if (!card) return '/cardback.jpg';
  if (typeof card.imagem === 'string' && card.imagem.trim()) return card.imagem;
  if (typeof card.imagen === 'string' && card.imagen.trim()) return card.imagen;
  return '/cardback.jpg';
}

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/auth/login?next=/profile');
}

const profile = await getOrCreateUserProfile(user.uid, user);
const title = 'Mi perfil';
const description = 'Gestiona tu cuenta, suscripcion y privacidad.';
const canUsePremium = isPremiumPlan(profile.plan) && profile.planStatus === 'active';
const hasPersonalArcane = Boolean(profile.personalArcaneNumber && profile.personalArcaneName);
const majorArcanaSnapshot = hasPersonalArcane
  ? await adminDb.collection('cards').where('arcano', '==', 'mayor').get()
  : null;
const majorArcanaCards: ProfileArcaneCard[] = majorArcanaSnapshot
  ? majorArcanaSnapshot.docs.map((doc) => ({
      id: doc.id,
      ...(doc.data() as Omit<ProfileArcaneCard, 'id'>),
    }))
  : [];

const personalArcaneCard: ProfileArcaneCard | null = majorArcanaCards.find(
  (card) => Number(card.numero) === profile.personalArcaneNumber
) ?? null;

const personalArcaneImage = getProfileArcaneImage(personalArcaneCard);
const arcaneBreakdown = profile.birthDate ? getPersonalArcaneBreakdown(profile.birthDate) : [];
const profileNameParts = splitFullName(profile.fullName || profile.displayName);
---

<Layout {title} {description}>
  <main class="container mx-auto max-w-5xl px-4 py-10 space-y-6">
    <section class="grid grid-cols-1 lg:grid-cols-[260px_minmax(0,1fr)] gap-5 items-start">
      <article class="surface-card p-4 lg:sticky lg:top-24">
        <h2 class="text-sm uppercase tracking-[0.2em] mb-3" style="color: var(--text-muted);">Carta Arcano Personal</h2>

        {hasPersonalArcane && personalArcaneCard ? (
          <a href={`/cards/${personalArcaneCard.id}?returnTo=/profile`} class="carta-link max-w-none">
            <article class="carta-item overflow-hidden">
              <div class="carta-image-container min-h-[20rem]">
                <Image
                  src={personalArcaneImage}
                  alt={`Carta ${profile.personalArcaneName}`}
                  width={300}
                  height={500}
                  loading="eager"
                  class="carta-image"
                  onerror="this.onerror=null;this.src='/cardback.jpg'"
                />
              </div>
              <div class="carta-info">
                <h3 class="carta-nombre">{profile.personalArcaneName}</h3>
                <span class="carta-numero">Arcano {profile.personalArcaneNumber}</span>
              </div>
            </article>
          </a>
        ) : (
          <div class="rounded-2xl p-5 text-center" style="background: color-mix(in srgb, var(--primary) 7%, var(--surface)); border: 1px dashed var(--border);">
            <p class="font-semibold" style="color: var(--text);">Aún sin carta natal</p>
            <p class="text-sm mt-2" style="color: var(--text-muted);">Completa tu fecha de nacimiento para ver aquí tu Arcano Personal.</p>
          </div>
        )}

        {arcaneBreakdown.length > 0 && (
          <div class="mt-4 rounded-2xl overflow-hidden" style="border: 1px solid var(--border); background: color-mix(in srgb, var(--surface) 92%, #ffffff);">
            <div class="px-4 py-3 border-b" style="border-color: var(--border);">
              <p class="text-sm font-semibold" style="color: var(--text);">Reducción del cálculo</p>
              <p class="text-xs mt-1" style="color: var(--text-muted);">Día + mes + año, reduciendo el año hasta llegar al Arcano final.</p>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr style="background: color-mix(in srgb, var(--primary) 16%, var(--surface)); color: var(--text);">
                    <th class="px-3 py-2 text-left">Día</th>
                    <th class="px-3 py-2 text-left">Mes</th>
                    <th class="px-3 py-2 text-left">Año</th>
                    <th class="px-3 py-2 text-center">=</th>
                    <th class="px-3 py-2 text-left">Reducción</th>
                  </tr>
                </thead>
                <tbody>
                  {arcaneBreakdown.map((step, index) => (
                    <tr style={index < arcaneBreakdown.length - 1 ? 'border-bottom: 1px solid var(--border);' : ''}>
                      <td class="px-3 py-3" style="color: var(--text);">{step.day}</td>
                      <td class="px-3 py-3" style="color: var(--text);">{step.month}</td>
                      <td class="px-3 py-3" style="color: var(--text);">{step.yearValue}</td>
                      <td class="px-3 py-3 text-center" style="color: var(--text-muted);">=</td>
                      <td class="px-3 py-3 font-semibold" style="color: var(--primary);">{step.total}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </article>

      <div class="space-y-5">
        <header class="surface-card p-6">
          <div class="flex items-start justify-between gap-4">
            <h1 class="text-3xl font-bold page-title">Mi perfil</h1>
            <a href="/profile/edit" class="btn-ui btn-ui-secondary px-3 py-2 inline-flex items-center gap-2" title="Editar perfil" aria-label="Editar perfil">
              <span aria-hidden="true">✏️</span>
              <span class="hidden sm:inline">Editar perfil</span>
            </a>
          </div>
          <p class="page-lead mt-2">Email: {profile.email || user.email}</p>
          {profile.fullName && <p class="page-lead">Nombre: <strong>{profile.fullName}</strong></p>}
          {profile.birthDate && <p class="page-lead">Fecha de nacimiento: <strong>{profile.birthDate}</strong></p>}
          {profile.birthHour && <p class="page-lead">Hora de nacimiento: <strong>{profile.birthHour}</strong></p>}
          <p class="page-lead">Plan actual: <strong>{getPlanLabel(profile.plan)}</strong> ({profile.planStatus})</p>
          <p class="page-lead">Tiradas guardadas: <strong>{profile.readingCount} / {getReadingLimit(profile.plan)}</strong></p>

          <div class="mt-5 rounded-2xl p-4" style="background: color-mix(in srgb, var(--primary) 8%, var(--surface)); border: 1px solid color-mix(in srgb, var(--primary) 18%, var(--border));">
            <h2 class="text-xl font-semibold page-title mb-2">Resumen espiritual</h2>
            {hasPersonalArcane ? (
              <>
                <p class="page-lead">Arcano actual: <strong>{profile.personalArcaneNumber}: {profile.personalArcaneName}</strong></p>
                {profile.personalArcaneMeaning && <p class="text-sm mt-2" style="color: var(--text-muted);">{profile.personalArcaneMeaning}</p>}
              </>
            ) : (
              <p class="page-lead">Aun no tienes Arcano Personal guardado. Completa tus datos para generarlo.</p>
            )}
          </div>
        </header>

        {Boolean(profile.bio || profile.hobbies || profile.socialInstagram || profile.socialFacebook || profile.socialTiktok || profile.socialWebsite) && (
          <section class="surface-card p-6 space-y-4">
            <h2 class="text-xl font-semibold page-title">Sobre mí</h2>
            
            {profile.bio && (
              <div class="space-y-1">
                <h3 class="text-xs uppercase tracking-wider font-semibold" style="color: var(--text-muted);">Descripción</h3>
                <p class="text-sm whitespace-pre-line" style="color: var(--text);">{profile.bio}</p>
              </div>
            )}

            {profile.hobbies && (
              <div class="space-y-1">
                <h3 class="text-xs uppercase tracking-wider font-semibold" style="color: var(--text-muted);">Pasatiempos</h3>
                <p class="text-sm" style="color: var(--text);">{profile.hobbies}</p>
              </div>
            )}

            {Boolean(profile.socialInstagram || profile.socialFacebook || profile.socialTiktok || profile.socialWebsite) && (
              <div class="space-y-2 pt-3 border-t" style="border-color: var(--border);">
                <h3 class="text-xs uppercase tracking-wider font-semibold mb-2" style="color: var(--text-muted);">Redes y Enlaces</h3>
                <div class="flex flex-wrap gap-4">
                  {profile.socialInstagram && (
                    <a
                      href={`https://instagram.com/${profile.socialInstagram.replace('@', '')}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
                      style="color: var(--primary);"
                      onmouseover="this.style.color='var(--primary-hover)'"
                      onmouseout="this.style.color='var(--primary)'"
                    >
                      <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0z"/>
                        <path d="M12 5.838c-3.403 0-6.162 2.759-6.162 6.162S8.597 18.162 12 18.162s6.162-2.759 6.162-6.162S15.403 5.838 12 5.838zM12 16c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4z"/>
                        <path d="M18.406 7.034c.796 0 1.441-.645 1.441-1.44s-.645-1.44-1.441-1.44-1.44.645-1.44 1.44.644 1.44 1.44 1.44z"/>
                      </svg>
                      <span>Instagram</span>
                    </a>
                  )}
                  {profile.socialFacebook && (
                    <a
                      href={profile.socialFacebook.startsWith('http') ? profile.socialFacebook : `https://facebook.com/${profile.socialFacebook}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
                      style="color: var(--primary);"
                      onmouseover="this.style.color='var(--primary-hover)'"
                      onmouseout="this.style.color='var(--primary)'"
                    >
                      <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
                      </svg>
                      <span>Facebook</span>
                    </a>
                  )}
                  {profile.socialTiktok && (
                    <a
                      href={`https://tiktok.com/@${profile.socialTiktok.replace('@', '')}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
                      style="color: var(--primary);"
                      onmouseover="this.style.color='var(--primary-hover)'"
                      onmouseout="this.style.color='var(--primary)'"
                    >
                      <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.17-2.86-.74-3.95-1.72-.1-.09-.17-.18-.26-.28v6.61c.03 2.12-.66 4.31-2.23 5.75-1.85 1.73-4.66 2.16-6.99 1.25-2.23-.87-3.8-3.08-3.97-5.46-.22-3.14 1.73-6.19 4.82-6.84 1-.22 2.05-.17 3.03.11v4.02c-.89-.35-1.89-.42-2.8-.08-1.25.46-2.14 1.73-2.19 3.07-.07 1.83 1.41 3.49 3.24 3.51 1.71.02 3.26-1.19 3.43-2.88.06-.57.03-1.15.03-1.73V.02z"/>
                      </svg>
                      <span>TikTok</span>
                    </a>
                  )}
                  {profile.socialWebsite && (
                    <a
                      href={profile.socialWebsite}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
                      style="color: var(--primary);"
                      onmouseover="this.style.color='var(--primary-hover)'"
                      onmouseout="this.style.color='var(--primary)'"
                    >
                      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                      </svg>
                      <span>Sitio web</span>
                    </a>
                  )}
                </div>
              </div>
            )}
          </section>
        )}

        <section class="surface-card p-6 space-y-4">
          <div>
            <h2 class="text-xl font-semibold page-title mb-2">Tu Arcano Personal</h2>
            <p class="text-sm" style="color: var(--text-muted);">Se calcula sumando día + mes + año. Si ese resultado queda en 21 o menos, ese número define el Arcano Mayor. Si da 22 o más, se reducen sus dígitos hasta llegar a un valor entre 1 y 21.</p>
          </div>

          {!hasPersonalArcane ? (
            <details class="rounded-xl p-4" style="background: color-mix(in srgb, var(--primary) 7%, var(--surface)); border: 1px solid var(--border);" open>
              <summary class="cursor-pointer font-semibold" style="color: var(--text);">Calcular Arcano Personal</summary>
              <p class="text-sm mt-3 mb-4" style="color: var(--text-muted);">
                Completa tu fecha de nacimiento para calcular y guardar tu carta natal.
              </p>

              <form id="arcaneForm" class="space-y-4" novalidate>
                <PersonalArcaneCalculator
                  idPrefix="profileArcane"
                  includeFullName={true}
                  initialFirstName={profileNameParts.firstName}
                  initialLastName={profileNameParts.lastName}
                  initialBirthDate={profile.birthDate || ''}
                  initialBirthHour={profile.birthHour || ''}
                />

                <div class="flex justify-end">
                  <button id="saveArcaneBtn" type="submit" class="btn-ui btn-ui-primary px-4 py-2">Guardar Arcano Personal</button>
                </div>
              </form>
            </details>
          ) : <></>}
        </section>

        <section class="surface-card p-6">
          <h2 class="text-xl font-semibold page-title mb-4">Últimas Tiradas Guardadas</h2>
          <div id="recentReadingsContainer" class="space-y-3">
            <p style="color: var(--text-muted);">Cargando historial...</p>
          </div>
          <div class="mt-4">
            <a href="/account/readings" class="btn-ui btn-ui-secondary px-4 py-2 inline-block">Ver todas las tiradas</a>
          </div>
        </section>
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="text-2xl font-bold page-title">Mi Membresía</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <!-- Caminante -->
        <article class="surface-card p-5 flex flex-col justify-between" style={profile.plan === 'free' ? 'border-color: var(--primary); background: color-mix(in srgb, var(--primary) 4%, var(--surface));' : ''}>
          <div>
            <div class="flex justify-between items-center mb-3">
              <h3 class="text-lg font-bold" style="color: var(--text);">Caminante</h3>
              {profile.plan === 'free' && <span class="text-xs px-2.5 py-1 rounded-full font-semibold" style="background: var(--success); color: white;">Activo</span>}
            </div>
            <p class="text-xs mb-4" style="color: var(--text-muted);">Membresía inicial de estudio y consulta elemental.</p>
            <ul class="text-sm space-y-2 mb-6" style="color: var(--text-muted);">
              <li>✨ 1 interpretación con IA por sesión.</li>
              <li>📁 Guarda hasta 3 tiradas.</li>
              <li>👥 Acceso básico a la comunidad.</li>
            </ul>
          </div>
          <div class="text-center pt-2">
            <span class="text-sm font-bold" style="color: var(--text-muted);">Plan Gratuito</span>
          </div>
        </article>

        <!-- Buscador -->
        <article class="surface-card p-5 flex flex-col justify-between" style={profile.plan.startsWith('buscador') || profile.plan.startsWith('premium') ? 'border-color: var(--primary); background: color-mix(in srgb, var(--primary) 4%, var(--surface));' : ''}>
          <div>
            <div class="flex justify-between items-center mb-3">
              <h3 class="text-lg font-bold" style="color: var(--text);">Buscador</h3>
              {(profile.plan.startsWith('buscador') || profile.plan.startsWith('premium')) && <span class="text-xs px-2.5 py-1 rounded-full font-semibold" style="background: var(--success); color: white;">Activo</span>}
            </div>
            <p class="text-xs mb-4" style="color: var(--text-muted);">Para buscadores que desean profundizar su aprendizaje.</p>
            <ul class="text-sm space-y-2 mb-6" style="color: var(--text-muted);">
              <li>✨ 2 interpretaciones con IA por sesión.</li>
              <li>📁 Guarda hasta 10 tiradas.</li>
              <li>👥 Acceso a reuniones grupales.</li>
              <li>📚 Talleres introductorios de tarot.</li>
            </ul>
          </div>
          <div class="flex flex-col gap-2">
            <button id="upgradeBuscadorMonthly" class="btn-ui btn-ui-primary w-full py-2 text-sm" style={profile.plan !== 'free' ? 'opacity: 0.5; pointer-events: none;' : ''} disabled={profile.plan !== 'free'}>$5.990 CLP / Mes</button>
            <button id="upgradeBuscadorAnnual" class="btn-ui btn-ui-secondary w-full py-2 text-sm" style={profile.plan !== 'free' ? 'opacity: 0.5; pointer-events: none;' : ''} disabled={profile.plan !== 'free'}>$59.900 CLP / Año</button>
          </div>
        </article>

        <!-- Guía Personal -->
        <article class="surface-card p-5 flex flex-col justify-between" style={profile.plan.startsWith('guia') ? 'border-color: var(--primary); background: color-mix(in srgb, var(--primary) 4%, var(--surface));' : ''}>
          <div>
            <div class="flex justify-between items-center mb-3">
              <h3 class="text-lg font-bold" style="color: var(--text);">Guía Personal</h3>
              {profile.plan.startsWith('guia') && <span class="text-xs px-2.5 py-1 rounded-full font-semibold" style="background: var(--success); color: white;">Activo</span>}
            </div>
            <p class="text-xs mb-4" style="color: var(--text-muted);">Acompañamiento individual de guía y mentoría.</p>
            <ul class="text-sm space-y-2 mb-6" style="color: var(--text-muted);">
              <li>✨ 3 interpretaciones con IA por sesión.</li>
              <li>📁 Guarda hasta 10 tiradas.</li>
              <li>📹 Videollamada mensual con mentor.</li>
              <li>💬 Chat directo y talleres avanzados.</li>
            </ul>
          </div>
          <div class="flex flex-col gap-2">
            <a href="mailto:contacto@taroterapeutico.net?subject=Solicitud%20de%20Membres%C3%ADa%20Gu%C3%ADa%20Personal" class="btn-ui btn-ui-primary w-full py-2 text-center text-sm">Solicitar Membresía</a>
          </div>
        </article>
      </div>

      {profile.plan !== 'free' && (
        <div class="flex justify-end pt-3">
          <button id="manageBilling" class="btn-ui btn-ui-neutral px-4 py-2 text-sm" type="button">Gestionar facturación</button>
        </div>
      )}
    </section>

    <p id="profileMsg" class="text-sm hidden" aria-live="polite"></p>
  </main>

  <script>
    import {
      normalizeBirthDateInput,
      validateBirthDate,
      validateBirthHour,
      validateFullName,
    } from '../lib/arcaneCalculator';

    const profileMsg = document.getElementById('profileMsg');

    function setMessage(text: string, isError = false) {
      if (!profileMsg) return;
      profileMsg.textContent = text;
      profileMsg.style.color = isError ? 'var(--danger)' : 'var(--success)';
      profileMsg.classList.remove('hidden');
    }

    // Cargar tiradas recientes
    async function loadRecentReadings() {
      const container = document.getElementById('recentReadingsContainer');
      if (!container) return;

      try {
        const response = await fetch('/api/readings/list?limit=3');
        const data = await response.json();

        if (!response.ok) {
          container.innerHTML = '<p style="color: var(--text-muted);">No hay tiradas guardadas.</p>';
          return;
        }

        if (!Array.isArray(data.readings) || data.readings.length === 0) {
          container.innerHTML = '<p style="color: var(--text-muted);">No hay tiradas guardadas.</p>';
          return;
        }

        container.innerHTML = data.readings.map((reading: any) => {
          const date = new Date(reading.createdAt).toLocaleDateString('es-ES', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
          });
          const preview = (reading.interpretation || '').substring(0, 120) + '...';
          return `
            <div class="rounded-lg p-3 border" style="border-color: var(--border); background: color-mix(in srgb, var(--primary) 4%, var(--surface));">
              <div class="flex justify-between items-start mb-1">
                <strong style="color: var(--text);">${reading.mode === 'mayores' ? 'Arcanos Mayores' : 'Tirada Mixta'}</strong>
                <small style="color: var(--text-muted);">${date}</small>
              </div>
              <p style="color: var(--text-muted); font-size: 0.875rem;">${preview}</p>
            </div>
          `;
        }).join('');
      } catch (error) {
        console.error('Error loading readings:', error);
        container.innerHTML = '<p style="color: var(--text-muted);">Error cargando tiradas.</p>';
      }
    }

    loadRecentReadings();

    function setArcaneBusy(isBusy: boolean) {
      const btn = document.getElementById('saveArcaneBtn') as HTMLButtonElement | null;
      if (!btn) return;
      btn.disabled = isBusy;
      btn.textContent = isBusy ? 'Guardando...' : 'Guardar Arcano Personal';
    }

    async function startCheckout(billingCycle: string) {
      const response = await fetch('/api/stripe/create-checkout-session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ billingCycle }),
      });

      const data = await response.json();
      if (!response.ok) {
        throw new Error(data.error || 'No se pudo iniciar Stripe Checkout.');
      }

      if (data.url) {
        window.location.href = data.url;
      }
    }

    document.getElementById('upgradeBuscadorMonthly')?.addEventListener('click', async () => {
      try {
        await startCheckout('monthly');
      } catch (error) {
        setMessage(error instanceof Error ? error.message : 'Error iniciando checkout', true);
      }
    });

    document.getElementById('upgradeBuscadorAnnual')?.addEventListener('click', async () => {
      try {
        await startCheckout('annual');
      } catch (error) {
        setMessage(error instanceof Error ? error.message : 'Error iniciando checkout', true);
      }
    });

    document.getElementById('manageBilling')?.addEventListener('click', async () => {
      try {
        const response = await fetch('/api/stripe/portal', { method: 'POST' });
        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.error || 'No se pudo abrir el portal de facturacion.');
        }
        window.location.href = data.url;
      } catch (error) {
        setMessage(error instanceof Error ? error.message : 'Error al abrir el portal', true);
      }
    });

    document.getElementById('arcaneForm')?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const firstName = (document.getElementById('profileArcane-firstName') as HTMLInputElement | null)?.value?.trim() ?? '';
      const lastName = (document.getElementById('profileArcane-lastName') as HTMLInputElement | null)?.value?.trim() ?? '';
      const fullName = [firstName, lastName].filter(Boolean).join(' ').trim();
      const rawBirthDate = (document.getElementById('profileArcane-birthDate') as HTMLInputElement | null)?.value ?? '';
      const birthHour = (document.getElementById('profileArcane-birthHour') as HTMLInputElement | null)?.value?.trim() ?? '';

      const birthDate = normalizeBirthDateInput(rawBirthDate);
      const fullNameValidation = validateFullName(fullName);
      const birthDateValidation = validateBirthDate(birthDate);
      const birthHourValidation = validateBirthHour(birthHour);

      if (!fullNameValidation.valid) {
        setMessage(fullNameValidation.message || 'Nombre inválido.', true);
        return;
      }

      if (!birthDateValidation.valid) {
        setMessage(birthDateValidation.message || 'Fecha de nacimiento inválida.', true);
        return;
      }

      if (!birthHourValidation.valid) {
        setMessage(birthHourValidation.message || 'Hora inválida.', true);
        return;
      }

      if (!window.confirm('¿Confirmas recalcular y guardar tu Arcano Personal con esta fecha?')) {
        return;
      }

      setArcaneBusy(true);

      try {
        const response = await fetch('/api/user/profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            firstName,
            lastName,
            birthDate,
            birthHour,
          }),
        });

        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.error || 'No se pudo guardar el Arcano Personal.');
        }

        setMessage('Arcano Personal actualizado. Recargando perfil...');
        setTimeout(() => window.location.reload(), 900);
      } catch (error) {
        setMessage(error instanceof Error ? error.message : 'No se pudo guardar el Arcano Personal.', true);
      } finally {
        setArcaneBusy(false);
      }
    });
  </script>
</Layout>
