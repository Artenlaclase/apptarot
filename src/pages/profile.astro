---
import Layout from '../layouts/Layout.astro';
import { getOrCreateUserProfile } from '../lib/auth-server';
import { getPlanLabel, FREE_READING_LIMIT, isPremiumPlan } from '../lib/plans';
import PersonalArcaneCalculator from '../components/PersonalArcaneCalculator.astro';
import { getPersonalArcaneBreakdown } from '../lib/arcaneCalculator';
import { db } from '../lib/firebase';
import { collection, getDocs, query, where } from 'firebase/firestore';
import '../styles/cards.css';

interface ProfileArcaneCard {
  id: string;
  numero?: string | number;
  imagem?: string | null;
  imagen?: string | null;
}

function splitFullName(fullName: string | undefined): { firstName: string; lastName: string } {
  const clean = (fullName || '').trim().replace(/\s+/g, ' ');
  if (!clean) return { firstName: '', lastName: '' };
  const parts = clean.split(' ');
  return {
    firstName: parts[0] || '',
    lastName: parts.slice(1).join(' '),
  };
}

function getProfileArcaneImage(card: ProfileArcaneCard | null): string {
  if (!card) return '/placeholder-card.jpg';
  if (typeof card.imagem === 'string' && card.imagem.trim()) return card.imagem;
  if (typeof card.imagen === 'string' && card.imagen.trim()) return card.imagen;
  return '/placeholder-card.jpg';
}

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/auth/login?next=/profile');
}

const profile = await getOrCreateUserProfile(user.uid, user);
const title = 'Mi perfil';
const description = 'Gestiona tu cuenta, suscripcion y privacidad.';
const canUsePremium = isPremiumPlan(profile.plan) && profile.planStatus === 'active';
const hasPersonalArcane = Boolean(profile.personalArcaneNumber && profile.personalArcaneName);
const majorArcanaSnapshot = hasPersonalArcane
  ? await getDocs(query(collection(db, 'cards'), where('arcano', '==', 'mayor')))
  : null;
const majorArcanaCards: ProfileArcaneCard[] = majorArcanaSnapshot
  ? majorArcanaSnapshot.docs.map((doc) => ({
      id: doc.id,
      ...(doc.data() as Omit<ProfileArcaneCard, 'id'>),
    }))
  : [];

const personalArcaneCard: ProfileArcaneCard | null = majorArcanaCards.find(
  (card) => Number(card.numero) === profile.personalArcaneNumber
) ?? null;

const personalArcaneImage = getProfileArcaneImage(personalArcaneCard);
const arcaneBreakdown = profile.birthDate ? getPersonalArcaneBreakdown(profile.birthDate) : [];
const profileNameParts = splitFullName(profile.fullName || profile.displayName);
---

<Layout {title} {description}>
  <main class="container mx-auto max-w-5xl px-4 py-10 space-y-6">
    <section class="grid grid-cols-1 lg:grid-cols-[260px_minmax(0,1fr)] gap-5 items-start">
      <article class="surface-card p-4 lg:sticky lg:top-24">
        <h2 class="text-sm uppercase tracking-[0.2em] mb-3" style="color: var(--text-muted);">Carta Arcano Personal</h2>

        {hasPersonalArcane && personalArcaneCard ? (
          <a href={`/cards/${personalArcaneCard.id}`} class="carta-link max-w-none">
            <article class="carta-item overflow-hidden">
              <div class="carta-image-container min-h-[20rem]">
                <img
                  src={personalArcaneImage}
                  alt={`Carta ${profile.personalArcaneName}`}
                  loading="lazy"
                  class="carta-image"
                  onerror="this.onerror=null;this.src='/placeholder-card.jpg'"
                />
              </div>
              <div class="carta-info">
                <h3 class="carta-nombre">{profile.personalArcaneName}</h3>
                <span class="carta-numero">Arcano {profile.personalArcaneNumber}</span>
              </div>
            </article>
          </a>
        ) : (
          <div class="rounded-2xl p-5 text-center" style="background: color-mix(in srgb, var(--primary) 7%, var(--surface)); border: 1px dashed var(--border);">
            <p class="font-semibold" style="color: var(--text);">Aún sin carta natal</p>
            <p class="text-sm mt-2" style="color: var(--text-muted);">Completa tu fecha de nacimiento para ver aquí tu Arcano Personal.</p>
          </div>
        )}

        {arcaneBreakdown.length > 0 && (
          <div class="mt-4 rounded-2xl overflow-hidden" style="border: 1px solid var(--border); background: color-mix(in srgb, var(--surface) 92%, #ffffff);">
            <div class="px-4 py-3 border-b" style="border-color: var(--border);">
              <p class="text-sm font-semibold" style="color: var(--text);">Reducción del cálculo</p>
              <p class="text-xs mt-1" style="color: var(--text-muted);">Día + mes + año, reduciendo el año hasta llegar al Arcano final.</p>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr style="background: color-mix(in srgb, var(--primary) 16%, var(--surface)); color: var(--text);">
                    <th class="px-3 py-2 text-left">Día</th>
                    <th class="px-3 py-2 text-left">Mes</th>
                    <th class="px-3 py-2 text-left">Año</th>
                    <th class="px-3 py-2 text-center">=</th>
                    <th class="px-3 py-2 text-left">Reducción</th>
                  </tr>
                </thead>
                <tbody>
                  {arcaneBreakdown.map((step, index) => (
                    <tr style={index < arcaneBreakdown.length - 1 ? 'border-bottom: 1px solid var(--border);' : ''}>
                      <td class="px-3 py-3" style="color: var(--text);">{step.day}</td>
                      <td class="px-3 py-3" style="color: var(--text);">{step.month}</td>
                      <td class="px-3 py-3" style="color: var(--text);">{step.yearValue}</td>
                      <td class="px-3 py-3 text-center" style="color: var(--text-muted);">=</td>
                      <td class="px-3 py-3 font-semibold" style="color: var(--primary);">{step.total}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </article>

      <header class="surface-card p-6">
        <div class="flex items-start justify-between gap-4">
          <h1 class="text-3xl font-bold page-title">Mi perfil</h1>
          <a href="/profile/edit" class="btn-ui btn-ui-secondary px-3 py-2 inline-flex items-center gap-2" title="Editar perfil" aria-label="Editar perfil">
            <span aria-hidden="true">✏️</span>
            <span class="hidden sm:inline">Editar perfil</span>
          </a>
        </div>
        <p class="page-lead mt-2">Email: {profile.email || user.email}</p>
        {profile.fullName && <p class="page-lead">Nombre: <strong>{profile.fullName}</strong></p>}
        <p class="page-lead">Plan actual: <strong>{getPlanLabel(profile.plan)}</strong> ({profile.planStatus})</p>
        <p class="page-lead">Tiradas guardadas: {profile.readingCount}{!canUsePremium ? ` / ${FREE_READING_LIMIT}` : ''}</p>

        <div class="mt-5 rounded-2xl p-4" style="background: color-mix(in srgb, var(--primary) 8%, var(--surface)); border: 1px solid color-mix(in srgb, var(--primary) 18%, var(--border));">
          <h2 class="text-xl font-semibold page-title mb-2">Resumen espiritual</h2>
          {hasPersonalArcane ? (
            <>
              <p class="page-lead">Arcano actual: <strong>{profile.personalArcaneNumber}: {profile.personalArcaneName}</strong></p>
              {profile.personalArcaneMeaning && <p class="text-sm mt-2" style="color: var(--text-muted);">{profile.personalArcaneMeaning}</p>}
            </>
          ) : (
            <p class="page-lead">Aun no tienes Arcano Personal guardado. Completa tus datos para generarlo.</p>
          )}
        </div>
      </header>
    </section>

    <section class="surface-card p-6 space-y-4">
      <div>
        <h2 class="text-xl font-semibold page-title mb-2">Tu Arcano Personal</h2>
        <p class="text-sm" style="color: var(--text-muted);">Se calcula sumando día + mes + año. Si ese resultado queda en 21 o menos, ese número define el Arcano Mayor. Si da 22 o más, se reducen sus dígitos hasta llegar a un valor entre 1 y 21.</p>
      </div>

      {!hasPersonalArcane ? (
        <details class="rounded-xl p-4" style="background: color-mix(in srgb, var(--primary) 7%, var(--surface)); border: 1px solid var(--border);" open>
          <summary class="cursor-pointer font-semibold" style="color: var(--text);">Calcular Arcano Personal</summary>
          <p class="text-sm mt-3 mb-4" style="color: var(--text-muted);">
            Completa tu fecha de nacimiento para calcular y guardar tu carta natal.
          </p>

          <form id="arcaneForm" class="space-y-4" novalidate>
            <PersonalArcaneCalculator
              idPrefix="profileArcane"
              includeFullName={true}
              initialFirstName={profileNameParts.firstName}
              initialLastName={profileNameParts.lastName}
              initialBirthDate={profile.birthDate || ''}
              initialBirthHour={profile.birthHour || ''}
            />

            <div class="flex justify-end">
              <button id="saveArcaneBtn" type="submit" class="btn-ui btn-ui-primary px-4 py-2">Guardar Arcano Personal</button>
            </div>
          </form>
        </details>
      ) : <></>}
    </section>

    <section class="surface-card p-6">
      <h2 class="text-xl font-semibold page-title mb-4">Últimas Tiradas Guardadas</h2>
      <div id="recentReadingsContainer" class="space-y-3">
        <p style="color: var(--text-muted);">Cargando historial...</p>
      </div>
      <div class="mt-4">
        <a href="/account/readings" class="btn-ui btn-ui-secondary px-4 py-2 inline-block">Ver todas las tiradas</a>
      </div>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <article class="surface-card p-6">
        <h2 class="text-xl font-semibold page-title mb-3">Suscripción</h2>
        <p class="page-lead mb-4">Desbloquea tiradas ilimitadas, videollamadas y chat personal.</p>
        <div class="flex flex-wrap gap-3">
          <button id="upgradeMonthly" class="btn-ui btn-ui-primary px-4 py-2" type="button">Premium mensual</button>
          <button id="upgradeAnnual" class="btn-ui btn-ui-secondary px-4 py-2" type="button">Premium anual</button>
          <button id="manageBilling" class="btn-ui btn-ui-neutral px-4 py-2" type="button">Gestionar facturación</button>
        </div>
      </article>

      <article class="surface-card p-6">
        <h2 class="text-xl font-semibold page-title mb-3">Configuración de perfil</h2>
        <p class="page-lead mb-4">Ahora la edición de contraseña, redes, pasatiempos, descripción y descarga de historial está en una sola pantalla.</p>
        <a href="/profile/edit" class="btn-ui btn-ui-primary px-4 py-2 inline-flex items-center gap-2">
          <span aria-hidden="true">⚙️</span>
          <span>Abrir edición de perfil</span>
        </a>
      </article>
    </section>

    <p id="profileMsg" class="text-sm hidden" aria-live="polite"></p>
  </main>

  <script is:inline type="module">
    import {
      normalizeBirthDateInput,
      validateBirthDate,
      validateBirthHour,
      validateFullName,
    } from '/src/lib/arcaneCalculator.ts';

    const profileMsg = document.getElementById('profileMsg');

    function setMessage(text, isError = false) {
      if (!profileMsg) return;
      profileMsg.textContent = text;
      profileMsg.style.color = isError ? 'var(--danger)' : 'var(--success)';
      profileMsg.classList.remove('hidden');
    }

    // Cargar tiradas recientes
    async function loadRecentReadings() {
      const container = document.getElementById('recentReadingsContainer');
      if (!container) return;

      try {
        const response = await fetch('/api/readings/list?limit=3');
        const data = await response.json();

        if (!response.ok) {
          container.innerHTML = '<p style="color: var(--text-muted);">No hay tiradas guardadas.</p>';
          return;
        }

        if (!Array.isArray(data.readings) || data.readings.length === 0) {
          container.innerHTML = '<p style="color: var(--text-muted);">No hay tiradas guardadas.</p>';
          return;
        }

        container.innerHTML = data.readings.map((reading) => {
          const date = new Date(reading.createdAt).toLocaleDateString('es-ES', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
          });
          const preview = (reading.interpretation || '').substring(0, 120) + '...';
          return `
            <div class="rounded-lg p-3 border" style="border-color: var(--border); background: color-mix(in srgb, var(--primary) 4%, var(--surface));">
              <div class="flex justify-between items-start mb-1">
                <strong style="color: var(--text);">${reading.mode === 'mayores' ? 'Arcanos Mayores' : 'Tirada Mixta'}</strong>
                <small style="color: var(--text-muted);">${date}</small>
              </div>
              <p style="color: var(--text-muted); font-size: 0.875rem;">${preview}</p>
            </div>
          `;
        }).join('');
      } catch (error) {
        console.error('Error loading readings:', error);
        container.innerHTML = '<p style="color: var(--text-muted);">Error cargando tiradas.</p>';
      }
    }

    loadRecentReadings();

    function setArcaneBusy(isBusy) {
      const btn = document.getElementById('saveArcaneBtn');
      if (!btn) return;
      btn.disabled = isBusy;
      btn.textContent = isBusy ? 'Guardando...' : 'Guardar Arcano Personal';
    }

    async function startCheckout(billingCycle) {
      const response = await fetch('/api/stripe/create-checkout-session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ billingCycle }),
      });

      const data = await response.json();
      if (!response.ok) {
        throw new Error(data.error || 'No se pudo iniciar Stripe Checkout.');
      }

      if (data.url) {
        window.location.href = data.url;
      }
    }

    document.getElementById('upgradeMonthly')?.addEventListener('click', async () => {
      try {
        await startCheckout('monthly');
      } catch (error) {
        setMessage(error instanceof Error ? error.message : 'Error iniciando checkout', true);
      }
    });

    document.getElementById('upgradeAnnual')?.addEventListener('click', async () => {
      try {
        await startCheckout('annual');
      } catch (error) {
        setMessage(error instanceof Error ? error.message : 'Error iniciando checkout', true);
      }
    });

    document.getElementById('manageBilling')?.addEventListener('click', async () => {
      try {
        const response = await fetch('/api/stripe/portal', { method: 'POST' });
        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.error || 'No se pudo abrir el portal de facturacion.');
        }
        window.location.href = data.url;
      } catch (error) {
        setMessage(error instanceof Error ? error.message : 'Error al abrir el portal', true);
      }
    });

    document.getElementById('arcaneForm')?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const firstName = document.getElementById('profileArcane-firstName')?.value?.trim() ?? '';
      const lastName = document.getElementById('profileArcane-lastName')?.value?.trim() ?? '';
      const fullName = [firstName, lastName].filter(Boolean).join(' ').trim();
      const rawBirthDate = document.getElementById('profileArcane-birthDate')?.value ?? '';
      const birthHour = document.getElementById('profileArcane-birthHour')?.value?.trim() ?? '';

      const birthDate = normalizeBirthDateInput(rawBirthDate);
      const fullNameValidation = validateFullName(fullName);
      const birthDateValidation = validateBirthDate(birthDate);
      const birthHourValidation = validateBirthHour(birthHour);

      if (!fullNameValidation.valid) {
        setMessage(fullNameValidation.message || 'Nombre inválido.', true);
        return;
      }

      if (!birthDateValidation.valid) {
        setMessage(birthDateValidation.message || 'Fecha de nacimiento inválida.', true);
        return;
      }

      if (!birthHourValidation.valid) {
        setMessage(birthHourValidation.message || 'Hora inválida.', true);
        return;
      }

      if (!window.confirm('¿Confirmas recalcular y guardar tu Arcano Personal con esta fecha?')) {
        return;
      }

      setArcaneBusy(true);

      try {
        const response = await fetch('/api/user/profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            firstName,
            lastName,
            birthDate,
            birthHour,
          }),
        });

        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.error || 'No se pudo guardar el Arcano Personal.');
        }

        setMessage('Arcano Personal actualizado. Recargando perfil...');
        setTimeout(() => window.location.reload(), 900);
      } catch (error) {
        setMessage(error instanceof Error ? error.message : 'No se pudo guardar el Arcano Personal.', true);
      } finally {
        setArcaneBusy(false);
      }
    });
  </script>
</Layout>
