---
// src/pages/random-cards.astro
import { db } from '../../lib/firebase';
import { collection, getDocs } from 'firebase/firestore';
import Layout from '../../layouts/Layout.astro';
import '../../styles/cards.css';

interface Card {
  id: string;
  nombre: string;
  numero?: number;
  valor?: string;
  arcano: 'mayor' | 'menor';
  imagem: string;
  imageLoaded?: boolean;
  imageError?: string;
}

const querySnapshot = await getDocs(collection(db, 'cards'));
const allCards = querySnapshot.docs.map(doc => {
  const data = doc.data();
  return {
    id: doc.id,
    nombre: data.nombre || 'Sin nombre',
    numero: data.numero,
    valor: data.valor,
    arcano: data.arcano || 'mayor',
    imagem: data.imagem || '/images/placeholder-card.jpg',
    imageLoaded: false
  };
});

// Separar arcanos mayores y menores
const arcanosMayores = allCards.filter(card => card.arcano === 'mayor');
const arcanosMenores = allCards.filter(card => card.arcano === 'menor');

console.log(`Cargadas ${allCards.length} cartas desde Firestore (${arcanosMayores.length} mayores, ${arcanosMenores.length} menores)`);

const pageTitle = "Cartas Aleatorias - Tarot de Marsella";
const pageDescription = "Genera una tirada aleatoria de cartas del Tarot de Marsella";
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="container mx-auto px-4 py-8 max-w-7xl">
    <header class="text-center mb-12">
      <h1 class="text-4xl font-bold text-purple-900 mb-4">Tirada de Cartas Aleatorias</h1>
      <p class="text-xl text-purple-700">Elige tu modalidad de tirada y número de cartas</p>
    </header>

    <section class="bg-white rounded-xl shadow-md p-6 mb-12 max-w-4xl mx-auto">
      <!-- Modalidad de tirada -->
      <div class="mb-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-3">Modalidad de tirada:</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <label class="flex items-center p-3 border-2 border-purple-200 rounded-lg cursor-pointer hover:bg-purple-50 transition-colors">
            <input type="radio" name="tiradaMode" value="mayores" class="mr-3 text-purple-600">
            <div>
              <div class="font-medium text-purple-800">Solo Arcanos Mayores</div>
              <div class="text-sm text-gray-600">22 cartas principales</div>
            </div>
          </label>
          
         <!--  <label class="flex items-center p-3 border-2 border-purple-200 rounded-lg cursor-pointer hover:bg-purple-50 transition-colors">
            <input type="radio" name="tiradaMode" value="mayores-aclaracion" class="mr-3 text-purple-600">
            <div>
              <div class="font-medium text-purple-800">Mayores + Aclaración</div>
              <div class="text-sm text-gray-600">Mayores con menores para aclarar</div>
            </div>
          </label>-->
          
          <label class="flex items-center p-3 border-2 border-purple-200 rounded-lg cursor-pointer hover:bg-purple-50 transition-colors">
            <input type="radio" name="tiradaMode" value="mixta" class="mr-3 text-purple-600" checked>
            <div>
              <div class="font-medium text-purple-800">Tirada Mixta</div>
              <div class="text-sm text-gray-600">Mayores y menores mezclados</div>
            </div>
          </label>
        </div>
      </div>

      <!-- Controles principales -->
      <div class="flex flex-col sm:flex-row gap-4 items-end justify-center mb-4">
        <div class="flex-1 w-full sm:w-auto">
          <label for="cardCount" class="block text-sm font-medium text-gray-700 mb-1">
            Número de cartas:
          </label>
          <input
            type="number"
            id="cardCount"
            name="cardCount"
            min="1"
            max="13"
            value="3"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-purple-500 focus:border-purple-500"
          />
        </div>
        <button
          type="button"
          id="generateBtn"
          class="px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-medium rounded-lg transition-colors"
        >
          Barajar Cartas
        </button>
        <button
          type="button"
          id="resetBtn"
          class="px-6 py-3 bg-gray-500 hover:bg-gray-600 text-white font-medium rounded-lg transition-colors"
        >
          Limpiar
        </button>
      </div>
      </div>

      <!-- Controles de aclaración (solo visible en ciertos modos) -->
      <div id="aclaracionControls" class="border-t pt-4 hidden">
        <div class="flex flex-col sm:flex-row gap-4 items-center justify-center flex-wrap">
          <div class="text-sm text-gray-600 w-full sm:w-auto">
            <strong>Acciones:</strong> Profundiza en tu tirada
          </div>
          <button
            type="button"
            id="aclaracionBtn"
            class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white font-medium rounded-lg transition-colors"
          >
            Sacar Carta de Aclaración
          </button>
          <button
            type="button"
            id="interpretarBtn"
            class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors"
          >
            ✨ Interpretar Tirada
          </button>
        </div>
      </div>
    </section>

    <section id="cardsContainer" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      <div id="initialMessage" class="col-span-full text-center py-12">
        <p class="text-xl text-gray-500">Selecciona tu modalidad de tirada y presiona "Barajar Cartas"</p>
      </div>
    </section>
    
    <div id="loadingIndicator" class="hidden text-center py-6">
      <div class="inline-block animate-spin rounded-full h-8 w-8 border-t-2 border-b-2 border-purple-600"></div>
      <p class="mt-2 text-purple-700">Cargando cartas...</p>
    </div>

    <!-- Sección de cartas de aclaración -->
    <section id="aclaracionSection" class="mt-12 hidden">
      <div class="bg-amber-50 border-2 border-amber-200 rounded-xl p-6">
        <h3 class="text-xl font-semibold text-amber-800 mb-4 text-center">
          🔍 Cartas de Aclaración
        </h3>
        <div id="aclaracionContainer" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        </div>
      </div>
    </section>

    <!-- Sección de interpretación IA -->
    <section id="interpretacionSection" class="mt-12 hidden">
      <div class="bg-gradient-to-br from-purple-50 to-indigo-50 border-2 border-purple-200 rounded-xl p-8">
        <h3 class="text-xl font-semibold text-purple-900 mb-6 text-center">✨ Interpretación de la Tirada</h3>
        <div id="interpretacionLoading" class="hidden text-center py-6">
          <div class="inline-block animate-spin rounded-full h-10 w-10 border-t-2 border-b-2 border-purple-600 mb-3"></div>
          <p class="text-purple-700">Consultando el oráculo...</p>
        </div>
        <div id="interpretacionTexto" class="text-gray-700 leading-relaxed text-base"></div>
      </div>
    </section>
  </main>
</Layout>

<script id="tarot-data" type="application/json" set:html={JSON.stringify({ allCards, arcanosMayores, arcanosMenores })}></script>

<script is:inline>
(function () {
  var data = null;
  function getData() {
    if (data) return data;
    var el = document.getElementById('tarot-data');
    data = el ? JSON.parse(el.textContent) : { allCards: [], arcanosMayores: [], arcanosMenores: [] };
    return data;
  }

  var DEFAULT_IMAGE = 'https://res.cloudinary.com/die8wz4ag/image/upload/v1747796437/a22_mbkkkq.jpg';

  function shuffle(arr) {
    var a = arr.slice();
    for (var i = a.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
    }
    return a;
  }

  function fixUrl(url) {
    if (!url || typeof url !== 'string') return DEFAULT_IMAGE;
    var c = url.trim();
    return (c.startsWith('http') || c.startsWith('/')) ? c : DEFAULT_IMAGE;
  }

  function buildSrc(url) {
    var clean = fixUrl(url);
    if (!clean.includes('res.cloudinary.com')) return clean;
    return clean.replace('/upload/', '/upload/w_380,f_auto,q_auto/');
  }

  function identifier(card) {
    if (card.arcano === 'menor' && card.valor) return card.valor;
    return card.numero ? String(card.numero) : '';
  }

  function revealCard(el) {
    if (el.dataset.revealed === '1') return;
    el.dataset.revealed = '1';
    el.style.cursor = 'default';

    var card = JSON.parse(el.dataset.card);
    var imgSrc = buildSrc(card.imagem);
    var id = identifier(card);
    var label = card.arcano === 'mayor' ? 'Arcano Mayor' : 'Arcano Menor';

    el.classList.add('flipping');
    setTimeout(function () {
      el.classList.remove('flippable-card', 'flipping');
      el.classList.add('revealed-card', 'card-revealed');
      el.innerHTML =
        '<a href="/cards/' + card.id + '" class="carta-random-link">' +
          '<article class="carta-random-container">' +
            '<div class="carta-random-image-wrapper">' +
              '<img src="' + imgSrc + '" alt="Carta ' + card.nombre + '" loading="lazy" class="carta-random-image" ' +
                'onerror="this.onerror=null;this.src=\'' + DEFAULT_IMAGE + '\'" />' +
            '</div>' +
            '<div class="carta-random-info">' +
              '<h3 class="carta-random-nombre">' + card.nombre + '</h3>' +
              '<div class="text-sm text-gray-600">' +
                '<span class="carta-random-numero">' + id + '</span>' +
                '<span class="block text-xs">' + label + '</span>' +
              '</div>' +
            '</div>' +
          '</article>' +
        '</a>';
    }, 300);
  }

  function makeCard(card) {
    var div = document.createElement('div');
    div.className = 'carta-random-item flippable-card';
    div.style.cursor = 'pointer';
    div.dataset.card = JSON.stringify(card);
    div.dataset.revealed = '0';
    div.innerHTML =
      '<div class="carta-random-container">' +
        '<div class="carta-random-image-wrapper">' +
          '<img src="/cardback.jpg" alt="Carta boca abajo" loading="lazy" class="carta-random-image" ' +
            'onerror="this.onerror=null;this.src=\'' + DEFAULT_IMAGE + '\'" />' +
        '</div>' +
        '<div class="carta-random-info">' +
          '<h3 class="carta-random-nombre">\u00bf?</h3>' +
          '<div class="text-sm text-gray-600">' +
            '<span class="carta-random-numero">Haz clic para revelar</span>' +
            '<span class="block text-xs">Carta oculta</span>' +
          '</div>' +
        '</div>' +
      '</div>';
    div.addEventListener('click', function () { revealCard(div); });
    return div;
  }

  function barajar() {
    var d = getData();
    var modeEl = document.querySelector('input[name="tiradaMode"]:checked');
    var mode = modeEl ? modeEl.value : 'mixta';
    var countEl = document.getElementById('cardCount');
    var count = Math.min(13, Math.max(1, parseInt(countEl ? countEl.value : '3') || 3));

    var pool = mode === 'mayores' ? d.arcanosMayores : d.allCards;
    var selected = shuffle(pool).slice(0, Math.min(count, pool.length));

    var container = document.getElementById('cardsContainer');
    if (!container) return;
    container.innerHTML = '';
    selected.forEach(function (card) {
      container.appendChild(makeCard(card));
    });

    var aclaracion = document.getElementById('aclaracionControls');
    if (aclaracion) aclaracion.classList.remove('hidden');
  }

  function limpiar() {
    var container = document.getElementById('cardsContainer');
    if (container) {
      container.innerHTML =
        '<div id="initialMessage" class="col-span-full text-center py-12">' +
          '<p class="text-xl text-gray-500">Selecciona tu modalidad de tirada y presiona &quot;Barajar Cartas&quot;</p>' +
        '</div>';
    }
    var ac = document.getElementById('aclaracionContainer');
    if (ac) ac.innerHTML = '';
    var as_ = document.getElementById('aclaracionSection');
    if (as_) as_.classList.add('hidden');
    var acCtrl = document.getElementById('aclaracionControls');
    if (acCtrl) acCtrl.classList.add('hidden');
    var interpSec = document.getElementById('interpretacionSection');
    if (interpSec) interpSec.classList.add('hidden');
    var interpTxt = document.getElementById('interpretacionTexto');
    if (interpTxt) interpTxt.innerHTML = '';
  }

  function makeAclaracionCard(card) {
    var div = document.createElement('div');
    div.className = 'carta-aclaracion-item';
    var imgSrc = buildSrc(card.imagem);
    var id = identifier(card);
    var label = card.arcano === 'mayor' ? 'Arcano Mayor' : 'Arcano Menor';
    div.innerHTML =
      '<a href="/cards/' + card.id + '" class="carta-random-link">' +
        '<article class="carta-random-container border-amber-300">' +
          '<div class="carta-random-image-wrapper">' +
            '<img src="' + imgSrc + '" alt="Carta ' + card.nombre + '" loading="lazy" class="carta-random-image" ' +
              'onerror="this.onerror=null;this.src=\'' + DEFAULT_IMAGE + '\'" />' +
          '</div>' +
          '<div class="carta-random-info">' +
            '<h3 class="carta-random-nombre">' + card.nombre + '</h3>' +
            '<div class="text-sm text-gray-600">' +
              '<span class="carta-random-numero">' + id + '</span>' +
              '<span class="block text-xs">' + label + '</span>' +
            '</div>' +
          '</div>' +
        '</article>' +
      '</a>';
    return div;
  }

  function escapeHtml(str) {
    var d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  function interpretar() {
    var cartasReveladas = [];
    document.querySelectorAll('[data-revealed="1"]').forEach(function (el) {
      if (el.dataset.card) {
        try { cartasReveladas.push(JSON.parse(el.dataset.card)); } catch (e) {}
      }
    });

    if (cartasReveladas.length === 0) {
      alert('Primero revela al menos una carta haciendo clic sobre ella.');
      return;
    }

    var sec     = document.getElementById('interpretacionSection');
    var loading = document.getElementById('interpretacionLoading');
    var texto   = document.getElementById('interpretacionTexto');
    var btn     = document.getElementById('interpretarBtn');

    if (sec)     sec.classList.remove('hidden');
    if (loading) loading.classList.remove('hidden');
    if (texto)   texto.innerHTML = '';
    if (btn)     { btn.disabled = true; btn.textContent = 'Consultando...'; }

    fetch('/api/interpretar', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ cartas: cartasReveladas })
    })
      .then(function (res) { return res.json(); })
      .then(function (data) {
        if (loading) loading.classList.add('hidden');
        if (btn)     { btn.disabled = false; btn.textContent = '✨ Interpretar Tirada'; }
        if (data.error) {
          if (texto) texto.innerHTML = '<p class="text-red-600">' + escapeHtml(data.error) + '</p>';
          return;
        }
        if (texto) {
          var lines = (data.interpretacion || '').split('\n').filter(function (l) { return l.trim(); });
          texto.innerHTML = lines.map(function (l) {
            return '<p class="mb-3 italic text-purple-900">' + escapeHtml(l) + '</p>';
          }).join('');
        }
      })
      .catch(function () {
        if (loading) loading.classList.add('hidden');
        if (btn)     { btn.disabled = false; btn.textContent = '✨ Interpretar Tirada'; }
        if (texto)   texto.innerHTML = '<p class="text-red-600">Error al contactar el servidor. Inténtalo de nuevo.</p>';
      });
  }

  function aclaracion() {
    var d = getData();
    var menores = shuffle(d.arcanosMenores);
    var card = menores[0];
    if (!card) { alert('No hay más arcanos menores disponibles'); return; }

    var sec = document.getElementById('aclaracionSection');
    if (sec) sec.classList.remove('hidden');
    var cont = document.getElementById('aclaracionContainer');
    if (cont) cont.appendChild(makeAclaracionCard(card));

    // quitar la carta usada del pool en memoria para no repetir
    d.arcanosMenores = d.arcanosMenores.filter(function (c) { return c.id !== card.id; });
  }

  function init() {
    var btnBarajar = document.getElementById('generateBtn');
    if (btnBarajar) btnBarajar.addEventListener('click', barajar);

    var btnLimpiar = document.getElementById('resetBtn');
    if (btnLimpiar) btnLimpiar.addEventListener('click', limpiar);

    var btnAclaracion = document.getElementById('aclaracionBtn');
    if (btnAclaracion) btnAclaracion.addEventListener('click', aclaracion);

    var btnInterpretar = document.getElementById('interpretarBtn');
    if (btnInterpretar) btnInterpretar.addEventListener('click', interpretar);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

<style>
  .flippable-card {
    @apply transition-transform duration-300;
  }

  .flippable-card:hover {
    @apply scale-105;
  }

  .flipping {
    @apply scale-110;
    transform: scale(1.1) rotateY(180deg);
    transition: transform 0.3s ease-in-out;
  }

  .card-revealed {
    animation: cardReveal 0.5s ease-out;
  }

  @keyframes cardReveal {
    from {
      opacity: 0;
      transform: scale(0.8) rotateY(180deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotateY(0deg);
    }
  }

  .carta-aclaracion-item {
    @apply transition-transform hover:scale-105;
  }
  
  .carta-aclaracion-item .carta-random-container {
    @apply bg-amber-50 border-2 border-amber-300;
  }
  
  input[type="radio"]:checked + div {
    @apply text-purple-900;
  }
  
  input[type="radio"]:checked {
    @apply text-purple-600;
  }
  
  label:has(input[type="radio"]:checked) {
    @apply border-purple-400 bg-purple-50;
  }
</style>