---
// src/pages/cards/index.astro
import Layout from '../../layouts/Layout.astro';
import '../../styles/cards.css';

const pageTitle = "Tarot de Marsella - Mazo Completo";
const pageDescription = "Descubre el mazo completo del Tarot de Marsella: Arcanos Mayores y Menores con sus significados profundos";
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="container mx-auto px-4 py-6 md:py-8 max-w-6xl">
    <!-- Header principal -->
    <header class="text-center mb-10 md:mb-16">
      <h1 class="text-3xl md:text-5xl font-bold page-title mb-3 md:mb-4">{pageTitle}</h1>
      <p class="text-base md:text-xl page-lead max-w-3xl mx-auto leading-relaxed">
        Explora la sabiduría ancestral del Tarot de Marsella, uno de los mazos más antiguos y respetados en la tradición esotérica occidental
      </p>
    </header>

    <!-- Introducción al Tarot de Marsella -->
    <section class="mb-10 md:mb-16 surface-soft p-5 md:p-8">
      <h2 class="text-2xl md:text-3xl font-semibold mb-5 md:mb-6 text-center page-title">El Tarot de Marsella</h2>
      <div class="prose prose-lg max-w-none" style="color: var(--text-muted);">
        <p class="mb-4">
          El Tarot de Marsella es considerado el arquetipo de todos los tarots. Originario del siglo XV, 
          este mazo ha preservado su esencia a través de los siglos, manteniendo un simbolismo puro y 
          poderoso que conecta con la sabiduría universal.
        </p>
        <p class="mb-4">
          Compuesto por 78 cartas divididas en dos grupos principales, cada carta del Tarot de Marsella 
          encierra conocimientos profundos sobre la condición humana, los ciclos de la vida y los 
          misterios del universo.
        </p>
        <p>
          Su estilo artístico único, con colores vibrantes y simbolos ancestrales, lo convierte en una 
          herramienta incomparable para la introspección, la meditación y la comprensión de los caminos 
          de la existencia.
        </p>
      </div>
    </section>

    <!-- Secciones de Arcanos -->
    <div class="grid md:grid-cols-2 gap-6 md:gap-12 mb-10 md:mb-16">
      
      <!-- Arcanos Mayores -->
      <section class="surface-card overflow-hidden hover:shadow-xl transition-shadow duration-300">
        <a href="/cards/major" class="block group">
          <div class="relative h-52 md:h-64 flex items-center justify-center" style="background: linear-gradient(140deg, color-mix(in srgb, var(--primary) 92%, #0f0f0f), color-mix(in srgb, var(--secondary) 58%, var(--primary)));">
            <div class="text-center">
              <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mb-4 mx-auto group-hover:scale-110 transition-transform duration-300">
                <span class="text-3xl font-bold" style="color: var(--primary);">I</span>
              </div>
              <h3 class="text-2xl font-bold text-white mb-2">Arcanos Mayores</h3>
              <p class="cta-muted">22 Cartas</p>
            </div>
          </div>
          <div class="p-4 md:p-6">
            <p class="page-lead mb-4 leading-relaxed">
              Los 22 Arcanos Mayores representan el viaje del alma a través de las experiencias 
              fundamentales de la vida. Desde El Loco hasta El Mundo, cada carta simboliza una 
              etapa de crecimiento espiritual y autoconocimiento.
            </p>
            <div class="flex items-center font-semibold transition-colors" style="color: var(--primary);">
              <span>Explorar Arcanos Mayores</span>
              <svg class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </div>
          </div>
        </a>
      </section>

      <!-- Arcanos Menores -->
      <section class="surface-card overflow-hidden hover:shadow-xl transition-shadow duration-300">
        <a href="/cards/minor" class="block group">
          <div class="relative h-52 md:h-64 flex items-center justify-center" style="background: linear-gradient(140deg, color-mix(in srgb, var(--secondary) 84%, #0f0f0f), color-mix(in srgb, var(--secondary) 65%, var(--primary)));">
            <div class="text-center">
              <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mb-4 mx-auto group-hover:scale-110 transition-transform duration-300">
                <span class="text-3xl font-bold" style="color: var(--secondary);">♠</span>
              </div>
              <h3 class="text-2xl font-bold text-white mb-2">Arcanos Menores</h3>
              <p class="cta-muted">56 Cartas</p>
            </div>
          </div>
          <div class="p-4 md:p-6">
            <p class="page-lead mb-4 leading-relaxed">
              Los 56 Arcanos Menores se dividen en cuatro palos: Bastos, Copas, Espadas y Oros. 
              Representan las situaciones cotidianas, emociones, pensamientos y aspectos 
              materiales de nuestra existencia diaria.
            </p>
            <div class="flex items-center font-semibold transition-colors" style="color: var(--secondary);">
              <span>Explorar Arcanos Menores</span>
              <svg class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </div>
          </div>
        </a>
      </section>
    </div>

    <!-- Los Cuatro Elementos -->
    <section class="mb-10 md:mb-16">
      <h2 class="text-2xl md:text-3xl font-semibold page-title mb-6 md:mb-8 text-center">Los Cuatro Elementos en el Tarot</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <div class="surface-soft p-4 md:p-6 text-center">
          <div class="w-16 h-16 bg-red-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white text-2xl font-bold">🔥</span>
          </div>
          <h3 class="text-xl font-semibold mb-2 page-title">Fuego - Bastos</h3>
          <p class="page-lead text-sm">Pasión, creatividad, energía vital</p>
        </div>

        <div class="surface-soft p-4 md:p-6 text-center">
          <div class="w-16 h-16 bg-blue-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white text-2xl font-bold">💧</span>
          </div>
          <h3 class="text-xl font-semibold mb-2 page-title">Agua - Copas</h3>
          <p class="page-lead text-sm">Emociones, intuición, espiritualidad</p>
        </div>

        <div class="surface-soft p-4 md:p-6 text-center">
          <div class="w-16 h-16 bg-gray-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white text-2xl font-bold">💨</span>
          </div>
          <h3 class="text-xl font-semibold mb-2 page-title">Aire - Espadas</h3>
          <p class="page-lead text-sm">Pensamiento, comunicación, conflicto</p>
        </div>

        <div class="surface-soft p-4 md:p-6 text-center">
          <div class="w-16 h-16 bg-yellow-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white text-2xl font-bold">🌍</span>
          </div>
          <h3 class="text-xl font-semibold mb-2 page-title">Tierra - Oros</h3>
          <p class="page-lead text-sm">Materia, recursos, prosperidad</p>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="text-center cta-panel p-6 md:p-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-3 md:mb-4">Comienza tu Viaje</h2>
      <p class="text-base md:text-xl cta-muted mb-6 md:mb-8 max-w-2xl mx-auto">
        Sumérgete en la sabiduría del Tarot de Marsella y descubre los mensajes que el universo 
        tiene para ti
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/cards/major" 
          class="bg-white px-8 py-3 rounded-lg font-semibold transition-colors"
          style="color: var(--primary);"
        >
          Ver Arcanos Mayores
        </a>
        <a 
          href="/cards/minor" 
          class="border-2 border-white text-white px-8 py-3 rounded-lg font-semibold transition-colors"
        >
          Ver Arcanos Menores
        </a>
      </div>
    </section>
  </main>
</Layout>