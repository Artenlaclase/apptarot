---
import Layout from '../layouts/Layout.astro';
const title = 'Acerca del Tarot de Marsella';
const description = 'Historia, simbolismo y enfoque de este proyecto sobre el Tarot de Marsella.';
---

<Layout {title} {description}>
  <main class="container mx-auto px-4 py-8 md:py-12 max-w-4xl">
    <header class="text-center mb-6 md:mb-8">
      <h1 class="text-3xl md:text-4xl font-bold page-title mb-3">{title}</h1>
      <p class="page-lead">Historia, simbolismo y enfoque editorial del proyecto.</p>
    </header>

    <section class="surface-card p-5 md:p-8 space-y-5">
      <p class="leading-relaxed" style="color: var(--text);">
        Este proyecto busca ofrecer una guía clara y visual sobre el Tarot de Marsella, uno de los mazos más
        influyentes en la tradición del tarot. Aquí encontrarás arcanos mayores y menores con descripciones,
        palabras clave y referencias simbólicas.
      </p>
      <p class="leading-relaxed" style="color: var(--text-muted);">
        Si deseas sugerir mejoras o colaborar, puedes escribir a
        <a class="token-link font-medium" href="mailto:contacto@taroterapeutico.net"> contacto@taroterapeutico.net</a>.
      </p>
    </section>
  </main>
</Layout>
