[debug] [2026-06-15T20:44:04.161Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/cartasmagicas-58d96/rulesets {"name":"projects/cartasmagicas-58d96/rulesets/cdf3a5fa-f184-4d74-8f72-ad3ba7d78a44","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function isSignedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isOwner(userId) {\r\n      return isSignedIn() && request.auth.uid == userId;\r\n    }\r\n\r\n    function isAdmin() {\r\n      return isSignedIn() && request.auth.token.admin == true;\r\n    }\r\n\r\n    match /cards/{cardId} {\r\n      allow read: if true;\r\n      allow write: if isAdmin();\r\n    }\r\n\r\n    match /users/{userId} {\r\n      allow read, update: if isOwner(userId);\r\n      allow create: if isOwner(userId);\r\n      allow delete: if false;\r\n\r\n      match /readings/{readingId} {\r\n        allow read, create, delete: if isOwner(userId);\r\n        allow update: if isOwner(userId);\r\n      }\r\n\r\n      match /chats/{chatId} {\r\n        allow read, write: if isOwner(userId);\r\n      }\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-06-15T20:44:04.733487Z","metadata":{"services":["cloud.firestore"]}}
